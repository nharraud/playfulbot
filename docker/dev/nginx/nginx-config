error_log /dev/stdout debug;
map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
}

upstream frontend {
        server frontend:3000;
}
upstream backend {
        server backend:4000;
}
upstream game_runner {
        server game_runner:4001;
}

server {
        client_max_body_size 10M; 

        listen 443 ssl;
        listen [::]:443 ssl;

        ssl_certificate /playfulbot/ssl/ssl.crt;
        ssl_certificate_key /playfulbot/ssl/ssl.key;

        server_name "local-playfulbot";

        location ^~/graphql {
                proxy_set_header Host $http_host;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Frame-Options SAMEORIGIN;
                proxy_send_timeout 1d;
                proxy_read_timeout 1d;

                proxy_pass http://backend/graphql;
        }

        location / {
                proxy_set_header Host $http_host;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Frame-Options SAMEORIGIN;
                proxy_send_timeout 1d;
                proxy_read_timeout 1d;

                proxy_pass http://frontend/;
        }
}

server {
        client_max_body_size 10M; 

        listen 4401 ssl;
        listen [::]:4401 ssl;

        ssl_certificate /playfulbot/ssl/ssl.crt;
        ssl_certificate_key /playfulbot/ssl/ssl.key;

        server_name localhost;

        location ^~/graphql {
                proxy_set_header Host $http_host;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Frame-Options SAMEORIGIN;
                proxy_send_timeout 1d;
                proxy_read_timeout 1d;

                proxy_pass http://game_runner/graphql;
        }
}

