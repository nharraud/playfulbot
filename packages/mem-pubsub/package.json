{
  "name": "mem-pubsub",
  "version": "1.0.0",
  "description": "In-Memory Publish/Subscribe implementation",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "rm -rf lib && tsc --project tsconfig.build.json && tsc-alias",
    "build:watch": "rm -rf lib && tsc --project tsconfig.build.json && (concurrently \"tsc --project tsconfig.build.json -w\" \"tsc-alias -w\")"
  },
  "author": "Nicolas Harraudeau",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.4.3",
    "vitest": "^3.1.1"
  }
}
