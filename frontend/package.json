{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PLAYFULBOT_CONFIG=../game-config.json vite",
    "build": "PLAYFULBOT_CONFIG=../game-config.json tsc && vite build",
    "serve": "PLAYFULBOT_CONFIG=../game-config.json vite preview",
    "test": "FIXME",
    "lint": "eslint src",
    "lint-fix": "eslint --fix src",
    "gen-graphql-backend": "graphql-codegen --watch --config codegen-backend.ts",
    "gen-graphql-runner": "graphql-codegen --watch --config codegen-game-runner.ts",
    "intl-extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "intl-compile": "formatjs compile-folder --ast lang src/i18n/lang"
  },
  "author": "Nicolas Harraudeau",
  "license": "AGPL-3.0-only",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@date-io/luxon": "^3.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@mui/styles": "^6.4.8",
    "@mui/x-date-pickers": "^8.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "copy-to-clipboard": "^3.3.3",
    "fast-json-patch": "^3.1.1",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "luxon": "^3.7.2",
    "playfulbot-game": "file:../packages/playfulbot-game",
    "playfulbot-game-frontend": "file:../packages/playfulbot-game-frontend",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.64.0",
    "react-intl": "^8.1.3",
    "react-router-dom": "^7.9.3",
    "react-syntax-highlighter": "^15.6.6",
    "rollup-plugin-playfulbot-config-loader": "file:../packages/rollup-plugin-playfulbot-config-loader",
    "ts-dedent": "^2.2.0",
    "web-vitals": "^5.1.0",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.12.2",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typed-document-node": "^6.0.2",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@parcel/watcher": "^2.5.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react-router": "^5.1.20",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-formatjs": "^11.2.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "lightningcss": "^1.32.0",
    "playfulbot-wallrace": "file:../packages/playfulbot-wallrace",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-css-modules": "^1.15.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
